{
  "name": "life-log-club",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "dev": "pnpm --parallel --filter @life-log-club/server --filter @life-log-club/web dev",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "invite": "pnpm --silent --filter @life-log-club/server invite"
  },
  "devDependencies": {
    "@life-log-club/contract": "workspace:*",
    "@orpc/client": "^1.16.2",
    "@orpc/contract": "^1.16.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
