PORT=8787
# The owner account runs migrations; the app account is what the API uses, so row-level security applies to it.
# Replace each CHANGE_ME with its own random password: openssl rand -hex 24
# The owner password must match POSTGRES_PASSWORD in the .env file at the repository root.
DATABASE_OWNER_URL=postgres://lifelog_owner:CHANGE_ME@localhost:5544/lifelog
DATABASE_URL=postgres://lifelog_app:CHANGE_ME@localhost:5544/lifelog
APP_ORIGIN=http://localhost:5173
# Encrypts private fields. Keep a copy somewhere safe: openssl rand -base64 32
ENCRYPTION_KEY=
