    "@life-log-club/llm": "workspace:*",
    "@orpc/server": "^1.16.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "zod": "^4.6.7"
  }
