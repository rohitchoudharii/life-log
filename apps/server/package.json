{
  "name": "@life-log-club/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "invite": "tsx --env-file-if-exists=.env src/cli/invite.ts",
    "db:replay-schedules": "tsx --env-file-if-exists=.env src/cli/replay-schedules.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@life-log-club/contract": "workspace:*",
    "@life-log-club/domain": "workspace:*",
    "@life-log-club/llm": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^0.1.100",
    "@open-spaced-repetition/binding": "^0.6.0",
    "@orpc/server": "^1.16.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "linkedom": "^0.18.15",
    "pdfjs-dist": "5.6.205",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  }
}
