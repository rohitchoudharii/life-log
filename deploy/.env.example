# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# The address members open. Its DNS A record must point at the server.
DOMAIN=lifelog.club

# Database passwords. Make each with: openssl rand -hex 24
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Encrypts private fields. Make it with: openssl rand -base64 32
# Keep a copy somewhere safe, away from the server: without it those fields can't be read.
ENCRYPTION_KEY=
